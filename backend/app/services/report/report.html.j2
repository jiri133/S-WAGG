<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <title>Raport de inspecție {{ mission_id }}</title>
  <style>
    body { font: 14px/1.45 system-ui, sans-serif; color: #1f2937; margin: 24px; }
    h1 { font-size: 20px; margin: 0 0 4px; }
    h2 { font-size: 16px; margin: 24px 0 8px; }
    .meta, .empty { color: #6b7280; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border-bottom: 1px solid #e5e7eb; padding: 4px 8px; text-align: left; vertical-align: top; }
    th { background: #f3f4f6; font-weight: 600; }
    .critical { color: #b91c1c; font-weight: 600; }
    .ok { color: #15803d; }
    ul { margin: 4px 0; padding-left: 20px; }
  </style>
</head>
<body>
  <h1>Raport de inspecție {{ mission_id }}</h1>
  <p class="meta">
    {{ findings|length }} finding-uri · {{ orders|length }} ordine de lucru ·
    {{ plan.days|length }} zile de plan · {{ alerts|length }} alerte
  </p>
  {%- if summary %}
  <h2>Rezumat</h2>
  <p>{{ summary }}</p>
  {%- endif %}

  <h2>Alerte critice</h2>
  {% if alerts %}
  <ul>
    {% for a in alerts %}
    <li class="{{ 'ok' if a.acknowledged else 'critical' }}">
      {{ a.id }}: {{ a.message }}{% if a.acknowledged %} (confirmată){% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty">Nicio alertă critică.</p>
  {% endif %}

  <h2>Finding-uri</h2>
  {% if findings %}
  <table>
    <tr>
      <th>ID</th><th>Modul</th><th>Clasă</th><th>Urgență</th>
      <th>ΔT (K)</th><th>Regulă aplicată</th><th>Review</th>
    </tr>
    {% for f in findings %}
    <tr>
      <td>{{ f.id }}</td>
      <td>{{ f.module_id }}</td>
      <td>{{ f.prediction.cls }}</td>
      <td class="{{ 'critical' if f.urgency == 'critical' else '' }}">{{ f.urgency }}</td>
      <td>{{ "%.1f"|format(f.evidence.delta_t_k) }}</td>
      <td>{{ f.evidence.rule_applied }}</td>
      <td>{{ f.review or 'în așteptare' }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="empty">Niciun finding.</p>
  {% endif %}

  <h2>Ordine de lucru</h2>
  {% if orders %}
  <table>
    <tr>
      <th>ID</th><th>Finding</th><th>Modul</th><th>String</th><th>Invertor</th>
      <th>Defect</th><th>Echipă</th><th>Durată (h)</th><th>Urgență</th>
    </tr>
    {% for w in orders %}
    <tr>
      <td>{{ w.id }}</td>
      <td>{{ w.finding_id }}</td>
      <td>{{ w.module_id }}</td>
      <td>{{ w.string }}</td>
      <td>{{ w.inverter }}</td>
      <td>{{ w.fault }}</td>
      <td>{{ w.crew }}</td>
      <td>{{ "%.1f"|format(w.est_hours) }}</td>
      <td class="{{ 'critical' if w.urgency == 'critical' else '' }}">{{ w.urgency }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="empty">Niciun ordin de lucru.</p>
  {% endif %}

  <h2>Plan</h2>
  {% for day in plan.days %}
  <p><b>Ziua {{ day.day }}</b> · {{ day.date }} · {{ day.weather }}</p>
  <ul>
    {% for t in day.tasks %}
    <li>
      {{ "%.1f"|format(t.start_h) }}h +{{ "%.1f"|format(t.duration_h) }}h ·
      {{ t.work_order_id }} ({{ t.crew }}): {{ t.reason }}
    </li>
    {% endfor %}
  </ul>
  {% endfor %}
  {% if plan.unscheduled %}
  <p class="critical">Neprogramate: {{ plan.unscheduled|join(', ') }}</p>
  {% endif %}
  <p class="meta">Pierdere evitată: {{ "%.1f"|format(plan.total_loss_avoided_kwh) }} kWh.</p>
</body>
</html>
