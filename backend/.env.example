# Copy to backend/.env and fill in secrets. Never commit .env.
# Environment variables override values in this file.
APP_NAME="Hackathon API"
ENV=dev
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Where the active farm config is exported for the RL pipeline:
# RL_CONFIG_DIR=../RL/configs
# RL checkout and interpreter for the planning simulation endpoint. When
# RL_PYTHON is unset the service probes RL/.venv/Scripts/python.exe and
# RL/.venv/bin/python.
# RL_ROOT=../RL
# RL_PYTHON=../RL/.venv/Scripts/python.exe
# Wall-clock limit for one planning run (an LLM day makes several calls):
# SIMULATION_TIMEOUT_S=600
CORS_ORIGINS=["http://localhost:5173"]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional LLM summary of the report (Q13): 1 = on, needs one of the keys above.
REPORT_LLM=0
