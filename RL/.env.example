# Copy to RL/.env and fill in secrets. Never commit .env.
# Loaded automatically by battery_rl.credentials; OS environment variables win.
DEEPSEEK_API_KEY=
# Optional; defaults to https://api.deepseek.com when empty.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
ENTSOE_API_TOKEN=
# ENTSOE_API_TOKEN is reserved for a future ENTSO-E downloader.
# The current pipeline reads the received ENTSO_15MIN.csv and does not need it.
